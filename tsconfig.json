{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "outDir": "dist",
    "paths": {
      "sharc-protocol": ["examples/sharc-protocol"],
      "sharc-container": ["examples/sharc-container"],
      "sharc-creative": ["examples/sharc-creative"],
      "sharc-mraid-bridge": ["examples/sharc-mraid-bridge"],
      "sharc-safeframe-bridge": ["examples/sharc-safeframe-bridge"],
      "sharc-omid-bridge": ["examples/sharc-omid-bridge"]
    }
  },
  "include": ["examples/sharc-*.js", "examples/sharc-globals.d.ts"],
  "exclude": ["node_modules", "examples/compliance-ads"]
}
