{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "outDir": "dist",
    "paths": {
      "sharc-protocol": ["src/sharc-protocol"],
      "sharc-container": ["src/sharc-container"],
      "sharc-creative": ["src/sharc-creative"],
      "sharc-mraid-bridge": ["src/sharc-mraid-bridge"],
      "sharc-safeframe-bridge": ["src/sharc-safeframe-bridge"],
      "sharc-omid-bridge": ["src/sharc-omid-bridge"]
    }
  },
  "include": ["src/sharc-*.js", "src/lifecycle-adapters/*.js", "src/types/**/*.d.ts"],
  "exclude": ["node_modules", "examples/compliance-ads"]
}
